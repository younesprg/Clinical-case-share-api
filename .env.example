# Kendi gizli anahtarınızı buraya girin ve dosyanın adını .env olarak değiştirin
SECRET_KEY=senin_gizli_anahtarin_buraya_gelecek
DATABASE_URL=postgresql://postgres:sifre@localhost/case_share
GEMINI_API_KEY=google_gemini_api_anahtarin
REDIS_URL=redis://localhost:6379

# ── Blockchain (Polygon Amoy Testnet) ──────────────────────────
# Remix IDE'den deploy ettikten sonra buraya ekleyin
MEDTOKEN_CONTRACT_ADDRESS=0x...
BACKEND_WALLET_ADDRESS=0x...
BACKEND_WALLET_PRIVATE_KEY=0x...
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/